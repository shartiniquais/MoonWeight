# Replace all three values. Example credentials are refused at API startup.
POSTGRES_DB=moonweight
POSTGRES_USER=moonweight
POSTGRES_PASSWORD=replace-with-16-or-more-random-characters
ADMIN_PASSWORD=replace-with-12-or-more-characters
SESSION_SECRET=replace-with-32-or-more-random-characters

# Local npm development. Compose uses its internal PostgreSQL hostname/port.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
API_PORT=3001
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
# Optional alternative for local npm development (URL-encode credentials):
# DATABASE_URL=postgres://user:password@localhost:5432/moonweight

# Exact allowed browser origins. Set to your HTTPS origin for public deployment.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# false is permitted for loopback HTTP only. Use true behind public HTTPS.
COOKIE_SECURE=false
