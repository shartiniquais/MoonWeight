POSTGRES_DB=moonweight
POSTGRES_USER=moonweight
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432

API_PORT=3001
WEB_PORT=8080

ADMIN_PASSWORD=replace-with-your-login-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Used by local npm development when PostgreSQL is exposed via docker-compose.dev.yml.
DATABASE_URL=postgres://moonweight:replace-with-a-strong-password@localhost:5432/moonweight

# Comma-separated browser origins allowed by the API in development/production.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Leave empty when the frontend and API are served from the same host through /api.
VITE_API_BASE_URL=
